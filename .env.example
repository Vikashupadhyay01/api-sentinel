# API-Sentinel environment variables
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.

# ---------- Capture proxy ----------
# URL of the upstream mock API
UPSTREAM_URL=http://127.0.0.1:8000

# Path for the JSONL event log (relative to repo root)
EVENTS_FILE=data/events.jsonl

# Set to 1 to enable enforcement mode (proxy blocks violating requests via detection API)
ENFORCE=0

# ---------- Detection backend ----------
# URL of the detection engine (used by the proxy in enforcement mode)
DETECTION_API=http://127.0.0.1:9000

